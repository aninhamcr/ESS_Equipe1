{
  "name": "salla-frontend",
  "private": true,
  "scripts": {
    "dev": "parcel src/index.html --port 3000",
    "build": "parcel build src/index.html",
    "test:e2e": "env -u ELECTRON_RUN_AS_NODE -u ELECTRON_NO_ATTACH_CONSOLE cypress run --spec tests/features/equipment_reservation.feature",
    "test:e2e:open": "env -u ELECTRON_RUN_AS_NODE -u ELECTRON_NO_ATTACH_CONSOLE cypress open",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:salas": "cypress run --spec \"../features/room-crud.feature\"",
    "cy:room": "cypress run --spec \"tests/features/room.feature\"",
    "cy:all": "cypress run --spec \"tests/features/**/*.feature\"",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "@badeball/cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "tests/**/*.{js,jsx}"
    ]
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@badeball/cypress-cucumber-preprocessor": "^20.1.2",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "babel-jest": "^30.4.1",
    "cypress": "^13.17.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "parcel": "^2.12.0"
  },
  "browserslist": "> 0.5%, last 2 versions, not dead"
}
